# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, mTLS/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=vscodemkt-tun

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true
# === STEP CA CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=443
VIRTUAL_HOST=vscgallery-tun.local
VIRTUAL_PROTO=https

# Step CA SSL certificate domain
LETSENCRYPT_HOST=vscgallery-tun.local

# Email for Step CA certificate registration
LETSENCRYPT_EMAIL=john.smith@mail.com
# mTLS
TLS_CLIENT_CERTIFICATE=/app/data/ca/ca-tls.cert