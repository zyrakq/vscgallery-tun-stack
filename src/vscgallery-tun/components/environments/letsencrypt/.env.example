# === LETSENCRYPT CONFIGURATION ===
# Virtual host domain for nginx-proxy
VIRTUAL_PORT=443
VIRTUAL_HOST=vscgallery-tun.example.com
VIRTUAL_PROTO=https

# Let's Encrypt SSL certificate domain
